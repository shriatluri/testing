# Plaid (free Development tier - sign up at dashboard.plaid.com)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Your email for reports
USER_EMAIL=

# SEC EDGAR requires a User-Agent with your email
SEC_EDGAR_EMAIL=

# Encryption key for Plaid tokens (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
